{"work":"quran","version":"tanzil","book":"quran","chapter":55,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلرَّحْمَـٰنُ"},
{"v":"2","t":"عَلَّمَ ٱلْقُرْءَانَ"},
{"v":"3","t":"خَلَقَ ٱلْإِنسَـٰنَ"},
{"v":"4","t":"عَلَّمَهُ ٱلْبَيَانَ"},
{"v":"5","t":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"},
{"v":"6","t":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"},
{"v":"7","t":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"},
{"v":"8","t":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"},
{"v":"9","t":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"},
{"v":"10","t":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},
{"v":"11","t":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"},
{"v":"12","t":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"},
{"v":"13","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"14","t":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ"},
{"v":"15","t":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"},
{"v":"16","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"17","t":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ"},
{"v":"18","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"19","t":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ"},
{"v":"20","t":"بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ"},
{"v":"21","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"22","t":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ"},
{"v":"23","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"24","t":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ"},
{"v":"25","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"26","t":"كُلُّ مَنْ عَلَيْهَا فَانٍ"},
{"v":"27","t":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ"},
{"v":"28","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"29","t":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ"},
{"v":"30","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"31","t":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ"},
{"v":"32","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"33","t":"يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ"},
{"v":"34","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"35","t":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ"},
{"v":"36","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"37","t":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ"},
{"v":"38","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"39","t":"فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ"},
{"v":"40","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"41","t":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ"},
{"v":"42","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"43","t":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ"},
{"v":"44","t":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ"},
{"v":"45","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"46","t":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"},
{"v":"47","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"48","t":"ذَوَاتَآ أَفْنَانٍ"},
{"v":"49","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"50","t":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},
{"v":"51","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"52","t":"فِيهِمَا مِن كُلِّ فَـٰكِهَةٍ زَوْجَانِ"},
{"v":"53","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"54","t":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ"},
{"v":"55","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"56","t":"فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},
{"v":"57","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"58","t":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ"},
{"v":"59","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"60","t":"هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ"},
{"v":"61","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"62","t":"وَمِن دُونِهِمَا جَنَّتَانِ"},
{"v":"63","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"64","t":"مُدْهَآمَّتَانِ"},
{"v":"65","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"66","t":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"},
{"v":"67","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"68","t":"فِيهِمَا فَـٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ"},
{"v":"69","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"70","t":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌ"},
{"v":"71","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"72","t":"حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ"},
{"v":"73","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"74","t":"لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},
{"v":"75","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"76","t":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ"},
{"v":"77","t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},
{"v":"78","t":"تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ"}
]}
