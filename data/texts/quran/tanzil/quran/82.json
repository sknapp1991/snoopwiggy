{"work":"quran","version":"tanzil","book":"quran","chapter":82,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"},
{"v":"2","t":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"},
{"v":"3","t":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"},
{"v":"4","t":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"},
{"v":"5","t":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"},
{"v":"6","t":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"},
{"v":"7","t":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},
{"v":"8","t":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"},
{"v":"9","t":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"},
{"v":"10","t":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ"},
{"v":"11","t":"كِرَامًا كَـٰتِبِينَ"},
{"v":"12","t":"يَعْلَمُونَ مَا تَفْعَلُونَ"},
{"v":"13","t":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"},
{"v":"14","t":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"},
{"v":"15","t":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"},
{"v":"16","t":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"},
{"v":"17","t":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},
{"v":"18","t":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},
{"v":"19","t":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"}
]}
