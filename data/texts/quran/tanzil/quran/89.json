{"work":"quran","version":"tanzil","book":"quran","chapter":89,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ"},
{"v":"2","t":"وَلَيَالٍ عَشْرٍ"},
{"v":"3","t":"وَٱلشَّفْعِ وَٱلْوَتْرِ"},
{"v":"4","t":"وَٱلَّيْلِ إِذَا يَسْرِ"},
{"v":"5","t":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"},
{"v":"6","t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},
{"v":"7","t":"إِرَمَ ذَاتِ ٱلْعِمَادِ"},
{"v":"8","t":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ"},
{"v":"9","t":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"},
{"v":"10","t":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"},
{"v":"11","t":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ"},
{"v":"12","t":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"},
{"v":"13","t":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},
{"v":"14","t":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"},
{"v":"15","t":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"},
{"v":"16","t":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ"},
{"v":"17","t":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"},
{"v":"18","t":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},
{"v":"19","t":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"},
{"v":"20","t":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"},
{"v":"21","t":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"},
{"v":"22","t":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"},
{"v":"23","t":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"},
{"v":"24","t":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},
{"v":"25","t":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},
{"v":"26","t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},
{"v":"27","t":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},
{"v":"28","t":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},
{"v":"29","t":"فَٱدْخُلِى فِى عِبَـٰدِى"},
{"v":"30","t":"وَٱدْخُلِى جَنَّتِى"}
]}
