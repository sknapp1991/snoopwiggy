{"work":"quran","version":"tanzil","book":"quran","chapter":100,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"},
{"v":"2","t":"فَٱلْمُورِيَـٰتِ قَدْحًا"},
{"v":"3","t":"فَٱلْمُغِيرَٰتِ صُبْحًا"},
{"v":"4","t":"فَأَثَرْنَ بِهِۦ نَقْعًا"},
{"v":"5","t":"فَوَسَطْنَ بِهِۦ جَمْعًا"},
{"v":"6","t":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"},
{"v":"7","t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},
{"v":"8","t":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"},
{"v":"9","t":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"},
{"v":"10","t":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},
{"v":"11","t":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}
]}
