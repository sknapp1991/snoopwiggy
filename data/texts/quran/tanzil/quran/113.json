{"work":"quran","version":"tanzil","book":"quran","chapter":113,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},
{"v":"2","t":"مِن شَرِّ مَا خَلَقَ"},
{"v":"3","t":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},
{"v":"4","t":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"},
{"v":"5","t":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}
]}
