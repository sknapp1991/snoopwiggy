{"work":"quran","version":"tanzil","book":"quran","chapter":78,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ"},
{"v":"2","t":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ"},
{"v":"3","t":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ"},
{"v":"4","t":"كَلَّا سَيَعْلَمُونَ"},
{"v":"5","t":"ثُمَّ كَلَّا سَيَعْلَمُونَ"},
{"v":"6","t":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا"},
{"v":"7","t":"وَٱلْجِبَالَ أَوْتَادًا"},
{"v":"8","t":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا"},
{"v":"9","t":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"},
{"v":"10","t":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا"},
{"v":"11","t":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا"},
{"v":"12","t":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"},
{"v":"13","t":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا"},
{"v":"14","t":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا"},
{"v":"15","t":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا"},
{"v":"16","t":"وَجَنَّـٰتٍ أَلْفَافًا"},
{"v":"17","t":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا"},
{"v":"18","t":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا"},
{"v":"19","t":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا"},
{"v":"20","t":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا"},
{"v":"21","t":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"},
{"v":"22","t":"لِّلطَّـٰغِينَ مَـَٔابًا"},
{"v":"23","t":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا"},
{"v":"24","t":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"},
{"v":"25","t":"إِلَّا حَمِيمًا وَغَسَّاقًا"},
{"v":"26","t":"جَزَآءً وِفَاقًا"},
{"v":"27","t":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا"},
{"v":"28","t":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا"},
{"v":"29","t":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا"},
{"v":"30","t":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"},
{"v":"31","t":"إِنَّ لِلْمُتَّقِينَ مَفَازًا"},
{"v":"32","t":"حَدَآئِقَ وَأَعْنَـٰبًا"},
{"v":"33","t":"وَكَوَاعِبَ أَتْرَابًا"},
{"v":"34","t":"وَكَأْسًا دِهَاقًا"},
{"v":"35","t":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا"},
{"v":"36","t":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا"},
{"v":"37","t":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"},
{"v":"38","t":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا"},
{"v":"39","t":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"},
{"v":"40","t":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا"}
]}
