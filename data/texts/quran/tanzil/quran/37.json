{"work":"quran","version":"tanzil","book":"quran","chapter":37,"verses":[
{"v":"1","t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلصَّـٰٓفَّـٰتِ صَفًّا"},
{"v":"2","t":"فَٱلزَّٰجِرَٰتِ زَجْرًا"},
{"v":"3","t":"فَٱلتَّـٰلِيَـٰتِ ذِكْرًا"},
{"v":"4","t":"إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ"},
{"v":"5","t":"رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ"},
{"v":"6","t":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ"},
{"v":"7","t":"وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ"},
{"v":"8","t":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ"},
{"v":"9","t":"دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ"},
{"v":"10","t":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ"},
{"v":"11","t":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ"},
{"v":"12","t":"بَلْ عَجِبْتَ وَيَسْخَرُونَ"},
{"v":"13","t":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ"},
{"v":"14","t":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ"},
{"v":"15","t":"وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ"},
{"v":"16","t":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"},
{"v":"17","t":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"},
{"v":"18","t":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ"},
{"v":"19","t":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ"},
{"v":"20","t":"وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ"},
{"v":"21","t":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"},
{"v":"22","t":"۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ"},
{"v":"23","t":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ"},
{"v":"24","t":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ"},
{"v":"25","t":"مَا لَكُمْ لَا تَنَاصَرُونَ"},
{"v":"26","t":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"},
{"v":"27","t":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},
{"v":"28","t":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"},
{"v":"29","t":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"},
{"v":"30","t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ"},
{"v":"31","t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ"},
{"v":"32","t":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ"},
{"v":"33","t":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"},
{"v":"34","t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},
{"v":"35","t":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"},
{"v":"36","t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"},
{"v":"37","t":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"},
{"v":"38","t":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"},
{"v":"39","t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},
{"v":"40","t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},
{"v":"41","t":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"},
{"v":"42","t":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ"},
{"v":"43","t":"فِى جَنَّـٰتِ ٱلنَّعِيمِ"},
{"v":"44","t":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ"},
{"v":"45","t":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"},
{"v":"46","t":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ"},
{"v":"47","t":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"},
{"v":"48","t":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"},
{"v":"49","t":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"},
{"v":"50","t":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},
{"v":"51","t":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"},
{"v":"52","t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"},
{"v":"53","t":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ"},
{"v":"54","t":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"},
{"v":"55","t":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"},
{"v":"56","t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"},
{"v":"57","t":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"},
{"v":"58","t":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},
{"v":"59","t":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"},
{"v":"60","t":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"},
{"v":"61","t":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ"},
{"v":"62","t":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"},
{"v":"63","t":"إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ"},
{"v":"64","t":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"},
{"v":"65","t":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ"},
{"v":"66","t":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},
{"v":"67","t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"},
{"v":"68","t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"},
{"v":"69","t":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"},
{"v":"70","t":"فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ"},
{"v":"71","t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"},
{"v":"72","t":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"},
{"v":"73","t":"فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ"},
{"v":"74","t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},
{"v":"75","t":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"},
{"v":"76","t":"وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"},
{"v":"77","t":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"},
{"v":"78","t":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},
{"v":"79","t":"سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ"},
{"v":"80","t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},
{"v":"81","t":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},
{"v":"82","t":"ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"},
{"v":"83","t":"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"},
{"v":"84","t":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ"},
{"v":"85","t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"},
{"v":"86","t":"أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ"},
{"v":"87","t":"فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ"},
{"v":"88","t":"فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ"},
{"v":"89","t":"فَقَالَ إِنِّى سَقِيمٌ"},
{"v":"90","t":"فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"},
{"v":"91","t":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"},
{"v":"92","t":"مَا لَكُمْ لَا تَنطِقُونَ"},
{"v":"93","t":"فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"},
{"v":"94","t":"فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"},
{"v":"95","t":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},
{"v":"96","t":"وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"},
{"v":"97","t":"قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"},
{"v":"98","t":"فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ"},
{"v":"99","t":"وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"},
{"v":"100","t":"رَبِّ هَبْ لِى مِنَ ٱلصَّـٰلِحِينَ"},
{"v":"101","t":"فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ حَلِيمٍ"},
{"v":"102","t":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ"},
{"v":"103","t":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"},
{"v":"104","t":"وَنَـٰدَيْنَـٰهُ أَن يَـٰٓإِبْرَٰهِيمُ"},
{"v":"105","t":"قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},
{"v":"106","t":"إِنَّ هَـٰذَا لَهُوَ ٱلْبَلَـٰٓؤُا۟ ٱلْمُبِينُ"},
{"v":"107","t":"وَفَدَيْنَـٰهُ بِذِبْحٍ عَظِيمٍ"},
{"v":"108","t":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},
{"v":"109","t":"سَلَـٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ"},
{"v":"110","t":"كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},
{"v":"111","t":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},
{"v":"112","t":"وَبَشَّرْنَـٰهُ بِإِسْحَـٰقَ نَبِيًّا مِّنَ ٱلصَّـٰلِحِينَ"},
{"v":"113","t":"وَبَـٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَـٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ"},
{"v":"114","t":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"},
{"v":"115","t":"وَنَجَّيْنَـٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"},
{"v":"116","t":"وَنَصَرْنَـٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ"},
{"v":"117","t":"وَءَاتَيْنَـٰهُمَا ٱلْكِتَـٰبَ ٱلْمُسْتَبِينَ"},
{"v":"118","t":"وَهَدَيْنَـٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},
{"v":"119","t":"وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ"},
{"v":"120","t":"سَلَـٰمٌ عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"},
{"v":"121","t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},
{"v":"122","t":"إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},
{"v":"123","t":"وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ"},
{"v":"124","t":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"},
{"v":"125","t":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَـٰلِقِينَ"},
{"v":"126","t":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"},
{"v":"127","t":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},
{"v":"128","t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},
{"v":"129","t":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},
{"v":"130","t":"سَلَـٰمٌ عَلَىٰٓ إِلْ يَاسِينَ"},
{"v":"131","t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},
{"v":"132","t":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},
{"v":"133","t":"وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ"},
{"v":"134","t":"إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"},
{"v":"135","t":"إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ"},
{"v":"136","t":"ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"},
{"v":"137","t":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},
{"v":"138","t":"وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ"},
{"v":"139","t":"وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ"},
{"v":"140","t":"إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ"},
{"v":"141","t":"فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ"},
{"v":"142","t":"فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ"},
{"v":"143","t":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ"},
{"v":"144","t":"لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ"},
{"v":"145","t":"۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ"},
{"v":"146","t":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"},
{"v":"147","t":"وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ"},
{"v":"148","t":"فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ"},
{"v":"149","t":"فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ"},
{"v":"150","t":"أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ"},
{"v":"151","t":"أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"},
{"v":"152","t":"وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ"},
{"v":"153","t":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ"},
{"v":"154","t":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},
{"v":"155","t":"أَفَلَا تَذَكَّرُونَ"},
{"v":"156","t":"أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ"},
{"v":"157","t":"فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ"},
{"v":"158","t":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},
{"v":"159","t":"سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"},
{"v":"160","t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},
{"v":"161","t":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},
{"v":"162","t":"مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ"},
{"v":"163","t":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"},
{"v":"164","t":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"},
{"v":"165","t":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"},
{"v":"166","t":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"},
{"v":"167","t":"وَإِن كَانُوا۟ لَيَقُولُونَ"},
{"v":"168","t":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"},
{"v":"169","t":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},
{"v":"170","t":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"},
{"v":"171","t":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"},
{"v":"172","t":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"},
{"v":"173","t":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ"},
{"v":"174","t":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},
{"v":"175","t":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},
{"v":"176","t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},
{"v":"177","t":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"},
{"v":"178","t":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},
{"v":"179","t":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},
{"v":"180","t":"سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"},
{"v":"181","t":"وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ"},
{"v":"182","t":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}
]}
