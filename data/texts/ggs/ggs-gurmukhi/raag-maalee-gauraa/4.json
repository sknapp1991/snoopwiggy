{"work":"ggs","version":"ggs-gurmukhi","book":"raag-maalee-gauraa","chapter":4,"title":"Ang 987","verses":[
{"v":"1","t":"ਬੂਝਤ ਦੀਪਕ ਮਿਲਤ ਤਿਲਤ ॥"},
{"v":"2","t":"ਜਲਤ ਅਗਨੀ ਮਿਲਤ ਨੀਰ ॥"},
{"v":"3","t":"ਜੈਸੇ ਬਾਰਿਕ ਮੁਖਹਿ ਖੀਰ ॥੧॥"},
{"v":"4","t":"ਜੈਸੇ ਰਣ ਮਹਿ ਸਖਾ ਭ੍ਰਾਤ ॥"},
{"v":"5","t":"ਜੈਸੇ ਭੂਖੇ ਭੋਜਨ ਮਾਤ ॥"},
{"v":"6","t":"ਜੈਸੇ ਕਿਰਖਹਿ ਬਰਸ ਮੇਘ ॥"},
{"v":"7","t":"ਜੈਸੇ ਪਾਲਨ ਸਰਨਿ ਸੇਂਘ ॥੨॥"},
{"v":"8","t":"ਗਰੁੜ ਮੁਖਿ ਨਹੀ ਸਰਪ ਤ੍ਰਾਸ ॥"},
{"v":"9","t":"ਸੂਆ ਪਿੰਜਰਿ ਨਹੀ ਖਾਇ ਬਿਲਾਸੁ ॥"},
{"v":"10","t":"ਜੈਸੋ ਆਂਡੋ ਹਿਰਦੇ ਮਾਹਿ ॥"},
{"v":"11","t":"ਜੈਸੋ ਦਾਨੋ ਚਕੀ ਦਰਾਹਿ ॥੩॥"},
{"v":"12","t":"ਬਹੁਤੁ ਓਪਮਾ ਥੋਰ ਕਹੀ ॥"},
{"v":"13","t":"ਹਰਿ ਅਗਮ ਅਗਮ ਅਗਾਧਿ ਤੁਹੀ ॥"},
{"v":"14","t":"ਊਚ ਮੂਚੌ ਬਹੁ ਅਪਾਰ ॥"},
{"v":"15","t":"ਸਿਮਰਤ ਨਾਨਕ ਤਰੇ ਸਾਰ ॥੪॥੩॥"},
{"v":"16","t":"ਮਾਲੀ ਗਉੜਾ ਮਹਲਾ ੫ ॥"},
{"v":"17","t":"ਇਹੀ ਹਮਾਰੈ ਸਫਲ ਕਾਜ ॥"},
{"v":"18","t":"ਅਪੁਨੇ ਦਾਸ ਕਉ ਲੇਹੁ ਨਿਵਾਜਿ ॥੧॥ ਰਹਾਉ ॥"},
{"v":"19","t":"ਚਰਨ ਸੰਤਹ ਮਾਥ ਮੋਰ ॥"},
{"v":"20","t":"ਨੈਨਿ ਦਰਸੁ ਪੇਖਉ ਨਿਸਿ ਭੋਰ ॥"},
{"v":"21","t":"ਹਸਤ ਹਮਰੇ ਸੰਤ ਟਹਲ ॥"},
{"v":"22","t":"ਪ੍ਰਾਨ ਮਨੁ ਧਨੁ ਸੰਤ ਬਹਲ ॥੧॥"},
{"v":"23","t":"ਸੰਤਸੰਗਿ ਮੇਰੇ ਮਨ ਕੀ ਪ੍ਰੀਤਿ ॥"},
{"v":"24","t":"ਸੰਤ ਗੁਨ ਬਸਹਿ ਮੇਰੈ ਚੀਤਿ ॥"},
{"v":"25","t":"ਸੰਤ ਆਗਿਆ ਮਨਹਿ ਮੀਠ ॥"},
{"v":"26","t":"ਮੇਰਾ ਕਮਲੁ ਬਿਗਸੈ ਸੰਤ ਡੀਠ ॥੨॥"},
{"v":"27","t":"ਸੰਤਸੰਗਿ ਮੇਰਾ ਹੋਇ ਨਿਵਾਸੁ ॥"},
{"v":"28","t":"ਸੰਤਨ ਕੀ ਮੋਹਿ ਬਹੁਤੁ ਪਿਆਸ ॥"},
{"v":"29","t":"ਸੰਤ ਬਚਨ ਮੇਰੇ ਮਨਹਿ ਮੰਤ ॥"},
{"v":"30","t":"ਸੰਤ ਪ੍ਰਸਾਦਿ ਮੇਰੇ ਬਿਖੈ ਹੰਤ ॥੩॥"},
{"v":"31","t":"ਮੁਕਤਿ ਜੁਗਤਿ ਏਹਾ ਨਿਧਾਨ ॥"},
{"v":"32","t":"ਪ੍ਰਭ ਦਇਆਲ ਮੋਹਿ ਦੇਵਹੁ ਦਾਨ ॥"},
{"v":"33","t":"ਨਾਨਕ ਕਉ ਪ੍ਰਭ ਦਇਆ ਧਾਰਿ ॥"},
{"v":"34","t":"ਚਰਨ ਸੰਤਨ ਕੇ ਮੇਰੇ ਰਿਦੇ ਮਝਾਰਿ ॥੪॥੪॥"},
{"v":"35","t":"ਮਾਲੀ ਗਉੜਾ ਮਹਲਾ ੫ ॥"},
{"v":"36","t":"ਸਭ ਕੈ ਸੰਗੀ ਨਾਹੀ ਦੂਰਿ ॥"},
{"v":"37","t":"ਕਰਨ ਕਰਾਵਨ ਹਾਜਰਾ ਹਜੂਰਿ ॥੧॥ ਰਹਾਉ ॥"},
{"v":"38","t":"ਸੁਨਤ ਜੀਓ ਜਾਸੁ ਨਾਮੁ ॥"},
{"v":"39","t":"ਦੁਖ ਬਿਨਸੇ ਸੁਖ ਕੀਓ ਬਿਸ੍ਰਾਮੁ ॥"},
{"v":"40","t":"ਸਗਲ ਨਿਧਿ ਹਰਿ ਹਰਿ ਹਰੇ ॥"},
{"v":"41","t":"ਮੁਨਿ ਜਨ ਤਾ ਕੀ ਸੇਵ ਕਰੇ ॥੧॥"},
{"v":"42","t":"ਜਾ ਕੈ ਘਰਿ ਸਗਲੇ ਸਮਾਹਿ ॥"},
{"v":"43","t":"ਜਿਸ ਤੇ ਬਿਰਥਾ ਕੋਇ ਨਾਹਿ ॥"},
{"v":"44","t":"ਜੀਅ ਜੰਤ੍ਰ ਕਰੇ ਪ੍ਰਤਿਪਾਲ ॥"},
{"v":"45","t":"ਸਦਾ ਸਦਾ ਸੇਵਹੁ ਕਿਰਪਾਲ ॥੨॥"},
{"v":"46","t":"ਸਦਾ ਧਰਮੁ ਜਾ ਕੈ ਦੀਬਾਣਿ ॥"},
{"v":"47","t":"ਬੇਮੁਹਤਾਜ ਨਹੀ ਕਿਛੁ ਕਾਣਿ ॥"},
{"v":"48","t":"ਸਭ ਕਿਛੁ ਕਰਨਾ ਆਪਨ ਆਪਿ ॥"},
{"v":"49","t":"ਰੇ ਮਨ ਮੇਰੇ ਤੂ ਤਾ ਕਉ ਜਾਪਿ ॥੩॥"},
{"v":"50","t":"ਸਾਧਸੰਗਤਿ ਕਉ ਹਉ ਬਲਿਹਾਰ ॥"},
{"v":"51","t":"ਜਾਸੁ ਮਿਲਿ ਹੋਵੈ ਉਧਾਰੁ ॥"},
{"v":"52","t":"ਨਾਮ ਸੰਗਿ ਮਨ ਤਨਹਿ ਰਾਤ ॥"},
{"v":"53","t":"ਨਾਨਕ ਕਉ ਪ੍ਰਭਿ ਕਰੀ ਦਾਤਿ ॥੪॥੫॥"},
{"v":"54","t":"ਮਾਲੀ ਗਉੜਾ ਮਹਲਾ ੫ ਦੁਪਦੇ ॥"},
{"v":"55","t":"ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥"},
{"v":"56","t":"ਹਰਿ ਸਮਰਥ ਕੀ ਸਰਨਾ ॥"},
{"v":"57","t":"ਜੀਉ ਪਿੰਡੁ ਧਨੁ ਰਾਸਿ ਮੇਰੀ ਪ੍ਰਭ ਏਕ ਕਾਰਨ ਕਰਨਾ ॥੧॥ ਰਹਾਉ ॥"},
{"v":"58","t":"ਸਿਮਰਿ ਸਿਮਰਿ ਸਦਾ ਸੁਖੁ ਪਾਈਐ ਜੀਵਣੈ ਕਾ ਮੂਲੁ ॥"},
{"v":"59","t":"ਰਵਿ ਰਹਿਆ ਸਰਬਤ ਠਾਈ ਸੂਖਮੋ ਅਸਥੂਲ ॥੧॥"}
]}
