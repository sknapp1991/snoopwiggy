{"work":"ggs","version":"ggs-gurmukhi","book":"raag-raamkalee","chapter":20,"title":"Ang 895","verses":[
{"v":"1","t":"ਸੰਤਨ ਕੇ ਪ੍ਰਾਣ ਅਧਾਰ ॥"},
{"v":"2","t":"ਊਚੇ ਤੇ ਊਚ ਅਪਾਰ ॥੩॥"},
{"v":"3","t":"ਸੁ ਮਤਿ ਸਾਰੁ ਜਿਤੁ ਹਰਿ ਸਿਮਰੀਜੈ ॥"},
{"v":"4","t":"ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪੇ ਦੀਜੈ ॥"},
{"v":"5","t":"ਸੂਖ ਸਹਜ ਆਨੰਦ ਹਰਿ ਨਾਉ ॥"},
{"v":"6","t":"ਨਾਨਕ ਜਪਿਆ ਗੁਰ ਮਿਲਿ ਨਾਉ ॥੪॥੨੭॥੩੮॥"},
{"v":"7","t":"ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥"},
{"v":"8","t":"ਸਗਲ ਸਿਆਨਪ ਛਾਡਿ ॥"},
{"v":"9","t":"ਕਰਿ ਸੇਵਾ ਸੇਵਕ ਸਾਜਿ ॥"},
{"v":"10","t":"ਅਪਨਾ ਆਪੁ ਸਗਲ ਮਿਟਾਇ ॥"},
{"v":"11","t":"ਮਨ ਚਿੰਦੇ ਸੇਈ ਫਲ ਪਾਇ ॥੧॥"},
{"v":"12","t":"ਹੋਹੁ ਸਾਵਧਾਨ ਅਪੁਨੇ ਗੁਰ ਸਿਉ ॥"},
{"v":"13","t":"ਆਸਾ ਮਨਸਾ ਪੂਰਨ ਹੋਵੈ ਪਾਵਹਿ ਸਗਲ ਨਿਧਾਨ ਗੁਰ ਸਿਉ ॥੧॥ ਰਹਾਉ ॥"},
{"v":"14","t":"ਦੂਜਾ ਨਹੀ ਜਾਨੈ ਕੋਇ ॥"},
{"v":"15","t":"ਸਤਗੁਰੁ ਨਿਰੰਜਨੁ ਸੋਇ ॥"},
{"v":"16","t":"ਮਾਨੁਖ ਕਾ ਕਰਿ ਰੂਪੁ ਨ ਜਾਨੁ ॥"},
{"v":"17","t":"ਮਿਲੀ ਨਿਮਾਨੇ ਮਾਨੁ ॥੨॥"},
{"v":"18","t":"ਗੁਰ ਕੀ ਹਰਿ ਟੇਕ ਟਿਕਾਇ ॥"},
{"v":"19","t":"ਅਵਰ ਆਸਾ ਸਭ ਲਾਹਿ ॥"},
{"v":"20","t":"ਹਰਿ ਕਾ ਨਾਮੁ ਮਾਗੁ ਨਿਧਾਨੁ ॥"},
{"v":"21","t":"ਤਾ ਦਰਗਹ ਪਾਵਹਿ ਮਾਨੁ ॥੩॥"},
{"v":"22","t":"ਗੁਰ ਕਾ ਬਚਨੁ ਜਪਿ ਮੰਤੁ ॥"},
{"v":"23","t":"ਏਹਾ ਭਗਤਿ ਸਾਰ ਤਤੁ ॥"},
{"v":"24","t":"ਸਤਿਗੁਰ ਭਏ ਦਇਆਲ ॥"},
{"v":"25","t":"ਨਾਨਕ ਦਾਸ ਨਿਹਾਲ ॥੪॥੨੮॥੩੯॥"},
{"v":"26","t":"ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥"},
{"v":"27","t":"ਹੋਵੈ ਸੋਈ ਭਲ ਮਾਨੁ ॥"},
{"v":"28","t":"ਆਪਨਾ ਤਜਿ ਅਭਿਮਾਨੁ ॥"},
{"v":"29","t":"ਦਿਨੁ ਰੈਨਿ ਸਦਾ ਗੁਨ ਗਾਉ ॥"},
{"v":"30","t":"ਪੂਰਨ ਏਹੀ ਸੁਆਉ ॥੧॥"},
{"v":"31","t":"ਆਨੰਦ ਕਰਿ ਸੰਤ ਹਰਿ ਜਪਿ ॥"},
{"v":"32","t":"ਛਾਡਿ ਸਿਆਨਪ ਬਹੁ ਚਤੁਰਾਈ ਗੁਰ ਕਾ ਜਪਿ ਮੰਤੁ ਨਿਰਮਲ ॥੧॥ ਰਹਾਉ ॥"},
{"v":"33","t":"ਏਕ ਕੀ ਕਰਿ ਆਸ ਭੀਤਰਿ ॥"},
{"v":"34","t":"ਨਿਰਮਲ ਜਪਿ ਨਾਮੁ ਹਰਿ ਹਰਿ ॥"},
{"v":"35","t":"ਗੁਰ ਕੇ ਚਰਨ ਨਮਸਕਾਰਿ ॥"},
{"v":"36","t":"ਭਵਜਲੁ ਉਤਰਹਿ ਪਾਰਿ ॥੨॥"},
{"v":"37","t":"ਦੇਵਨਹਾਰ ਦਾਤਾਰ ॥"},
{"v":"38","t":"ਅੰਤੁ ਨ ਪਾਰਾਵਾਰ ॥"},
{"v":"39","t":"ਜਾ ਕੈ ਘਰਿ ਸਰਬ ਨਿਧਾਨ ॥"},
{"v":"40","t":"ਰਾਖਨਹਾਰ ਨਿਦਾਨ ॥੩॥"},
{"v":"41","t":"ਨਾਨਕ ਪਾਇਆ ਏਹੁ ਨਿਧਾਨ ॥"},
{"v":"42","t":"ਹਰੇ ਹਰਿ ਨਿਰਮਲ ਨਾਮ ॥"},
{"v":"43","t":"ਜੋ ਜਪੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਇ ॥"},
{"v":"44","t":"ਨਾਨਕ ਕਰਮਿ ਪਰਾਪਤਿ ਹੋਇ ॥੪॥੨੯॥੪੦॥"},
{"v":"45","t":"ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥"},
{"v":"46","t":"ਦੁਲਭ ਦੇਹ ਸਵਾਰਿ ॥"},
{"v":"47","t":"ਜਾਹਿ ਨ ਦਰਗਹ ਹਾਰਿ ॥"},
{"v":"48","t":"ਹਲਤਿ ਪਲਤਿ ਤੁਧੁ ਹੋਇ ਵਡਿਆਈ ॥"},
{"v":"49","t":"ਅੰਤ ਕੀ ਬੇਲਾ ਲਏ ਛਡਾਈ ॥੧॥"},
{"v":"50","t":"ਰਾਮ ਕੇ ਗੁਨ ਗਾਉ ॥"},
{"v":"51","t":"ਹਲਤੁ ਪਲਤੁ ਹੋਹਿ ਦੋਵੈ ਸੁਹੇਲੇ ਅਚਰਜ ਪੁਰਖੁ ਧਿਆਉ ॥੧॥ ਰਹਾਉ ॥"},
{"v":"52","t":"ਊਠਤ ਬੈਠਤ ਹਰਿ ਜਾਪੁ ॥"},
{"v":"53","t":"ਬਿਨਸੈ ਸਗਲ ਸੰਤਾਪੁ ॥"},
{"v":"54","t":"ਬੈਰੀ ਸਭਿ ਹੋਵਹਿ ਮੀਤ ॥"},
{"v":"55","t":"ਨਿਰਮਲੁ ਤੇਰਾ ਹੋਵੈ ਚੀਤ ॥੨॥"},
{"v":"56","t":"ਸਭ ਤੇ ਊਤਮ ਇਹੁ ਕਰਮੁ ॥"},
{"v":"57","t":"ਸਗਲ ਧਰਮ ਮਹਿ ਸ੍ਰੇਸਟ ਧਰਮੁ ॥"},
{"v":"58","t":"ਹਰਿ ਸਿਮਰਨਿ ਤੇਰਾ ਹੋਇ ਉਧਾਰੁ ॥"},
{"v":"59","t":"ਜਨਮ ਜਨਮ ਕਾ ਉਤਰੈ ਭਾਰੁ ॥੩॥"},
{"v":"60","t":"ਪੂਰਨ ਤੇਰੀ ਹੋਵੈ ਆਸ ॥"},
{"v":"61","t":"ਜਮ ਕੀ ਕਟੀਐ ਤੇਰੀ ਫਾਸ ॥"},
{"v":"62","t":"ਗੁਰ ਕਾ ਉਪਦੇਸੁ ਸੁਨੀਜੈ ॥"},
{"v":"63","t":"ਨਾਨਕ ਸੁਖਿ ਸਹਜਿ ਸਮੀਜੈ ॥੪॥੩੦॥੪੧॥"}
]}
