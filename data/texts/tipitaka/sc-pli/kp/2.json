{"work":"tipitaka","version":"sc-pli","book":"kp","chapter":2,"title":"Dasasikkhāpada","verses":[
{"v":"1","t":"Pāṇātipātā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"2","t":"Adinnādānā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"3","t":"Abrahmacariyā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"4","t":"Musāvādā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"5","t":"Surāmerayamajjapamādaṭṭhānā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"6","t":"Vikālabhojanā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"7","t":"Naccagītavāditavisūkadassanā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"8","t":"Mālāgandhavilepanadhāraṇamaṇḍanavibhūsanaṭṭhānā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"9","t":"Uccāsayanamahāsayanā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"10","t":"Jātarūparajatapaṭiggahaṇā veramaṇisikkhāpadaṁ samādiyāmi."},
{"v":"11","t":"Dasasikkhāpadaṁ."}
]}
