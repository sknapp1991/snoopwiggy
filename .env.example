# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# AI provider for translations (Phase 2): "gemini" (default, free tier during development) or "anthropic"
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Built-in Ask AI panel (future paid tier). Keep "false"; "Ask in…" hand-off is used instead.
NEXT_PUBLIC_FEATURE_ASK_AI_PANEL=false
